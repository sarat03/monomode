<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed even for loopback sockets; the app only ever connects to this phone's own adbd (ADR 0002). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Exposure check: is a VPN active. Read-only, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The pairing code is typed into a notification reply. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Names of home-screen apps for the kiosk pin picker; no broad package visibility needed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="PhoneWarden"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".Pairing$PairReceiver" android:exported="false" />
    </application>
</manifest>
